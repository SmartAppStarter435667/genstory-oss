// wrangler.jsonc — API Gateway Worker (Hono + Durable Objects + Workers AI)
//
// v2: OCI VM連携を廃止。Workers AI(テキスト生成・画像生成)を直接呼び出す
// 構成のため、外部エンドポイントの秘密情報は不要になった。
//
// 任意: ストーリー生成にNVIDIA NIM(build.nvidia.com、無料ホスト型APIはテキスト
// モデルのみ対応)を優先使用したい場合は以下を設定する(未設定ならWorkers AIのみ使用):
//   npx wrangler secret put NVIDIA_NIM_API_KEY
//   (任意) vars.NVIDIA_NIM_MODEL で catalog ID を上書き。既定は "meta/llama-3.3-70b-instruct"
//
// __KV_NAMESPACE_ID__ は deploy-workers.yml が scripts/provision-resources.sh の
// 実行結果で自動的に置換する。手動編集は不要。
{
  "name": "genstory-oss-api-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOOK_SESSION",
        "class_name": "BookSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BookSession"]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "BOOK_CACHE",
      "id": "__KV_NAMESPACE_ID__"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BOOK_ASSETS",
      "bucket_name": "genstory-oss-assets"
    }
  ]
}
